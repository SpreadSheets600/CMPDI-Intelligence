# CMPDI Intelligence — local configuration. Copy to .env and fill in.
# .env is git-ignored: secrets here never enter version control.
# Every variable below is optional; unset means the built-in default.

# --- Inference provider: auto | ollama | huggingface | openai_compatible | none
CMPDI_LLM_PROVIDER=auto

# --- Ollama (local server) ---
CMPDI_OLLAMA_URL=http://127.0.0.1:11434
CMPDI_OLLAMA_MODEL=gemma4:31b-cloud

# --- Hugging Face (locally downloaded model only; never auto-downloaded) ---
CMPDI_HF_MODEL=

# --- OpenAI-compatible API (any /chat/completions server) ---
CMPDI_OPENAI_BASE_URL=
CMPDI_OPENAI_MODEL=
# API key: .env file only. Never paste keys into chat, Settings, or git.
CMPDI_OPENAI_API_KEY=

# --- Embeddings (local sentence-transformers; loaded once, kept resident) ---
CMPDI_EMBEDDING_MODEL=google/embeddinggemma-300m
# Token for HF-gated models (e.g. EmbeddingGemma). Accept the model license at
# huggingface.co/google/embeddinggemma-300m first, or the fallback loads.
HF_TOKEN=

# --- Retrieval / OCR ---
CMPDI_RETRIEVAL_K=8
CMPDI_OCR_MIN_CONF=85
# Tesseract languages, comma-separated. Needs matching traineddata installed
# (e.g. hin); RapidOCR keeps its built-in model regardless.
CMPDI_OCR_LANGS=eng

# --- Review attribution (recorded on approvals and conflict decisions) ---
CMPDI_OPERATOR=
# Optional shared token for mutating API calls (header X-API-Token).
# Empty (default) leaves the single-user setup ungated.
CMPDI_API_TOKEN=

# --- Manual baseline for the time-saved KPI, in minutes ---
# Stated planning figure until measured on site; prefer the Settings
# override (manual_baseline_minutes) once a real measurement exists.
CMPDI_MANUAL_BASELINE_MINUTES=138

# --- Storage ---
CMPDI_DATA_DIR=./data
CMPDI_DB_PATH=
